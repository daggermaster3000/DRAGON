# Copy to .env and adjust. Everything runs locally by default.

# Port the PWA is served on (http://<pi-ip>:8000)
APP_PORT=8000

# Where the SQLite database + backups live (inside the container).
DATA_DIR=/app/data

# --- Classification -----------------------------------------------------
# Provider: "ollama" (local, private — default), "openai" (cloud), or "rules"
# (deterministic only, zero AI). Rules + the bank's own categories already
# cover ~85% of transactions; AI only fills the gaps.
AI_PROVIDER=ollama

# Local Ollama (used when AI_PROVIDER=ollama). No data leaves the Pi.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Cloud OpenAI (used ONLY when AI_PROVIDER=openai). Payee names are sent to
# OpenAI — leave blank unless you explicitly opt in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If AI is enabled but unreachable, fall back to deterministic rules instead
# of failing the import.
AI_GRACEFUL_FALLBACK=true

# CORS: "*" is fine for a single-user self-hosted app on your LAN.
CORS_ORIGINS=*
